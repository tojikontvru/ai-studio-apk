<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AIStudio" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#0e0e12</item>
        <item name="android:statusBarColor">#0e0e12</item>
        <item name="android:navigationBarColor">#0e0e12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">#FF5530</item>
        <item name="colorPrimaryDark">#CC4426</item>
        <item name="colorAccent">#EA5EC1</item>
    </style>

    <style name="Theme.AIStudio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0e0e12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.AIStudio</item>
    </style>
</resources>
